----------------------------------------------------------------
-- ตัวแปรระบบทำงานภายใน
----------------------------------------------------------------
local AutoSteal = false
local SelectedEgg = ""
local FlySpeed = 100
local FastPick = false
local NoDismissal = false
local CloneActive = false

-- ค้นหาจุด Safe Zone ในแมพ (ปรับชื่อตามแมพที่เล่นได้)
local function GetSafeZone()
    return workspace:FindFirstChild("SafeZone") 
        or workspace:FindFirstChild("Safezone") 
        or workspace:FindFirstChild("SpawnLocation") 
        or workspace:FindFirstChild("Spawn") 
        or LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
end

-- ดึงรายการไข่ทั้งหมดใน workspace
local function GetEggList()
    local eggs = {}
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") and string.find(string.lower(v.Name), "egg") then
            table.insert(eggs, v.Name)
        end
    end
    if #eggs == 0 then eggs = {"ไม่พบ Egg ในระยะ"} end
    return eggs
end

----------------------------------------------------------------
-- Tab 1: ขโมยไข่
----------------------------------------------------------------
local StealTab = Window:CreateTab("ขโมยไข่", 4483362458)

local EggDropdown = StealTab:CreateDropdown({
   Name = "เลือก Egg ที่ต้องการขโมย",
   Options = GetEggList(),
   CurrentOption = {"เลือกไข่"},
   MultipleOptions = false,
   Callback = function(Option)
      SelectedEgg = Option[1]
   end,
})

StealTab:CreateButton({
   Name = "🔄 รีเฟรชรายชื่อ Egg",
   Callback = function()
      EggDropdown:Refresh(GetEggList())
   end,
})

StealTab:CreateSlider({
   Name = "ความเร็วบินขโมย (1-900)",
   Range = {1, 900},
   Increment = 1,
   Suffix = "Speed",
   CurrentValue = 100,
   Callback = function(Value)
      FlySpeed = Value
   end,
})

StealTab:CreateToggle({
   Name = "เริ่มการขโมยไข่อัตโนมัติ",
   CurrentValue = false,
   Callback = function(Value)
      AutoSteal = Value
      if AutoSteal then
         task.spawn(function()
            while AutoSteal do
               task.wait(0.1)
               local char = LocalPlayer.Character
               if not char or not char:FindFirstChild("HumanoidRootPart") then continue end
               local hrp = char.HumanoidRootPart
               
               -- ค้นหา Object ไข่
               local targetEgg = nil
               for _, v in pairs(workspace:GetDescendants()) do
                  if v:IsA("Model") and v.Name == SelectedEgg and v:FindFirstChildWhichIsA("BasePart") then
                     targetEgg = v
                     break
                  end
               end
               
               if targetEgg then
                  local eggPart = targetEgg:FindFirstChildWhichIsA("BasePart")
                  
                  -- 1. บินขึ้นเล็กน้อยและบินไปหา Egg
                  hrp.CFrame = hrp.CFrame + Vector3.new(0, 10, 0)
                  task.wait(0.2)
                  
                  local dist = (hrp.Position - eggPart.Position).Magnitude
                  local duration = math.clamp(dist / FlySpeed, 0.1, 30)
                  
                  local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
                  local tween = TweenService:Create(hrp, tweenInfo, {CFrame = eggPart.CFrame + Vector3.new(0, 3, 0)})
                  tween:Play()
                  tween.Completed:Wait()
                  
                  -- 2. กดหยิบ ProximityPrompt
                  local prompt = targetEgg:FindFirstChildWhichIsA("ProximityPrompt", true)
                  if prompt then
                     fireproximityprompt(prompt)
                  end
                  task.wait(0.3)
                  
                  -- 3. บินกลับ Safe Zone
                  local safeZone = GetSafeZone()
                  if safeZone then
                     local safeCFrame = safeZone:IsA("BasePart") and safeZone.CFrame or safeZone.Position
                     
                     -- เงื่อนไขสปีด 100-900: ทิ้งแล้วลงไปเก็บซ้ำระหว่างทาง
                     if FlySpeed >= 100 then
                        local startPos = hrp.Position
                        local endPos = safeCFrame.Position
                        local totalDist = (endPos - startPos).Magnitude
                        local steps = math.floor(totalDist / 50) -- ทิ้งและเก็บทุกๆ 50 หน่วย
                        
                        for i = 1, steps do
                           if not AutoSteal then break end
                           
                           -- บินไปกลางทาง
                           local nextPos = startPos:Lerp(endPos, i / steps)
                           hrp.CFrame = CFrame.new(nextPos)
                           task.wait(0.1)
                           
                           -- จำลองการกดคำว่า "ทิ้ง" บนหน้าจอ (Drop Item)
                           local backPackTool = char:FindFirstChildOfClass("Tool")
                           if backPackTool then
                              backPackTool.Parent = workspace
                           end
                           
                           -- บินลงมาหา Egg ที่กดทิ้งแล้วกด E หยิบขึ้นมาใหม่
                           local droppedEgg = workspace:FindFirstChild(SelectedEgg) or targetEgg
                           if droppedEgg and droppedEgg:FindFirstChildWhichIsA("BasePart") then
                              local dropPart = droppedEgg:FindFirstChildWhichIsA("BasePart")
                              hrp.CFrame = dropPart.CFrame + Vector3.new(0, 2, 0)
                              task.wait(0.2)
                              
                              local dropPrompt = droppedEgg:FindFirstChildWhichIsA("ProximityPrompt", true)
                              if dropPrompt then
                                 fireproximityprompt(dropPrompt)
                              end
                              task.wait(0.2)
                           end
                        end
                     end
                     
                     -- บินเข้า Safe Zone สมบูรณ์
                     local finalTween = TweenService:Create(hrp, TweenInfo.new(1, Enum.EasingStyle.Linear), {CFrame = safeCFrame + Vector3.new(0, 3, 0)})
                     finalTween:Play()
                     finalTween.Completed:Wait()
                  end
               end
            end
         end)
      end
   end,
})

