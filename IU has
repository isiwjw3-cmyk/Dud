-- Tab 2: ฟังค์ชันเสริม (หยิบไว / No Dismissal)
----------------------------------------------------------------
local UtilityTab = Window:CreateTab("ฟังค์ชันเสริม", 4483362458)

UtilityTab:CreateToggle({
   Name = "หยิบไข่ไว ( Instant Pick )",
   CurrentValue = false,
   Callback = function(Value)
      FastPick = Value
      task.spawn(function()
         while FastPick do
            task.wait(0.2)
            for _, prompt in pairs(workspace:GetDescendants()) do
               if prompt:IsA("ProximityPrompt") then
                  if FastPick then
                     prompt.HoldDuration = 0
                  end
               end
            end
         end
      end)
   end,
})

UtilityTab:CreateToggle({
   Name = "No dismissal (ระบบสร้างร่างโคลนวิ่ง)",
   CurrentValue = false,
   Callback = function(Value)
      NoDismissal = Value
   end,
})

-- ตรวจจับเมื่อผู้ใช้ไปกดหยิบ Egg ขณะเปิด No dismissal
game:GetService("ProximityPromptService").PromptButtonHoldBegan:Connect(function(prompt, player)
   if player == LocalPlayer and NoDismissal and not CloneActive then
      CloneActive = true
      
      local char = LocalPlayer.Character
      if not char or not char:FindFirstChild("HumanoidRootPart") then return end
      local hrp = char.HumanoidRootPart
      local humanoid = char:FindFirstChildOfClass("Humanoid")
      
      -- ล็อกตัวละครหลัก ห้ามขยับ ห้ามหันจอ
      hrp.Anchored = true
      if humanoid then humanoid.WalkSpeed = 0 end
      
      -- สร้างร่างโคลน (Clone)
      char.Archivable = true
      local cloneChar = char:Clone()
      cloneChar.Name = LocalPlayer.Name .. "_Clone"
      cloneChar.Parent = workspace
      char.Archivable = false
      
      local cloneHrp = cloneChar:FindFirstChild("HumanoidRootPart")
      local cloneHumanoid = cloneChar:FindFirstChildOfClass("Humanoid")
      
      if cloneHrp and cloneHumanoid then
         -- วิ่งด้วยความเร็วมากๆๆๆๆๆ ไป safe zone
         cloneHumanoid.WalkSpeed = 500
         local safeZone = GetSafeZone()
         if safeZone then
            local targetPos = safeZone:IsA("BasePart") and safeZone.Position or safeZone.Position
            cloneHumanoid:MoveTo(targetPos)
            
            -- รอจนกว่าร่างโคลนจะวิ่งเข้าถึง Safe zone
            local reached = false
            local conn
            conn = cloneHumanoid.MoveToFinished:Connect(function()
               reached = true
               if conn then conn:Disconnect() end
            end)
            
            repeat task.wait(0.1) until reached or (cloneHrp.Position - targetPos).Magnitude < 10
            
            -- เมื่อเข้า safe zone แล้ว ลบร่างโคลนออก และปลดล็อกตัวละครหลัก
            cloneChar:Destroy()
            hrp.Anchored = false
            if humanoid then humanoid.WalkSpeed = 16 end
            CloneActive = false
         end
      else
         hrp.Anchored = false
         if humanoid then humanoid.WalkSpeed = 16 end
         CloneActive = false
      end
   end
end)

